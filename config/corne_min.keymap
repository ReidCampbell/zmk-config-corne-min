#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    quick-tap-ms = <400>;
};

/ {
    behaviors {
        td_copy_cut: td_copy_cut {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COPY_CUT";
            #binding-cells = <0>;
            bindings = <&copy_macro>, <&cut_macro>;
            tapping-term-ms = <300>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER_MOUSE";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Arrow {
            bindings = <&Arrow>;
            key-positions = <9 10>;
        };

        Paste {
            bindings = <&paste_macro>;
            key-positions = <28 27>;
        };

        CurlyL {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <19 20>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20 21>;
        };

        ParaL {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        SquareL {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
        };

        SquareR {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
        };

        ParaR {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <9 8>;
        };

        CurlyR {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <21 20>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <14 15 16>;
        };

        Undo {
            timeout-ms = <50>;
            bindings = <&undo_macro>;
            key-positions = <3 4>;
        };

        Copy {
            bindings = <&td_copy_cut>;
            key-positions = <15 16>;
        };

        switch {
            bindings = <&kp LS(LA(LC(LG(F12))))>;
            key-positions = <5 6>;
        };

        switch2 {
            bindings = <&kp LS(LA(LC(LG(F11))))>;
            key-positions = <17 18>;
        };

        switch3 {
            bindings = <&kp LS(LC(LA(LG(F16))))>;
            key-positions = <29 30>;
        };

        Switch4 {
            bindings = <&kp LS(LA(LC(LG(F13))))>;
            key-positions = <4 7>;
        };

        Switch5 {
            bindings = <&kp LS(LA(LC(LG(F14))))>;
            key-positions = <19 16>;
        };

        Switch6 {
            bindings = <&kp LS(LA(LC(LG(F15))))>;
            key-positions = <28 31>;
        };

        Esc {
            bindings = <&kp ESC>;
            key-positions = <1 10>;
        };
    };

    macros {
        Arrow: Arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW";
        };

        copy_macro: copy_macro {
            compatible = "zmk,behavior-macro";
            label = "COPY_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>;
        };

        cut_macro: cut_macro {
            compatible = "zmk,behavior-macro";
            label = "CUT_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LG(X)>;
        };

        paste_macro: paste_macro {
            compatible = "zmk,behavior-macro";
            label = "PASTE_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
        };

        undo_macro: undo_macro {
            compatible = "zmk,behavior-macro";
            label = "UNDO_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LG(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            bindings = <
                &none              &kp W              &kp L         &kp Y            &kp P            &kp B                               &kp Z      &kp F            &kp O            &kp U                 &kp SQT            &none
                &none              &hrm LEFT_SHIFT C  &hrm LCTRL R  &hrm LEFT_ALT S  &hrm LEFT_GUI T  &kp G                               &kp M      &hrm LEFT_GUI N  &hrm LEFT_ALT E  &hrm RIGHT_CONTROL I  &hrm LEFT_SHIFT A   &none
                &none              &kp Q              &kp J         &kp V            &kp D            &kp K                               &kp X      &kp H            &kp FSLH         &kp COMMA             &kp DOT            &none
                                                                                &lt 1 TAB        &lt 2 SPACE      &mt LA(LC(LG(LEFT_SHIFT))) ENTER    &ht 3 MB4  &lt 1 BACKSPACE  &mkp MB5
            >;
        };

        nav_layer {
            display-name = "NAVI";

            bindings = <
                &none  &trans                      &kp N7                 &kp N8                    &kp N9                    &kp PLUS      &trans      &kp PAGE_UP       &kp UP            &kp PAGE_DOWN     &trans           &none
                &none  &mt LEFT_SHIFT KP_NUMBER_0  &mt LCTRL KP_NUMBER_4  &mt LEFT_ALT KP_NUMBER_5  &mt LEFT_GUI KP_NUMBER_6  &kp MINUS     &kp HOME    &kp LEFT_ARROW    &kp DOWN_ARROW    &kp RIGHT_ARROW   &kp END          &none
                &none  &trans                      &kp N1                 &kp N2                    &kp N3                    &kp PERIOD    &kp LG(N5)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4) &none
                                                                                                       &trans                    &kp LEFT_GUI              &trans        &trans      &trans            &trans
            >;
        };

        sym_layer {
            display-name = "SYM";

            bindings = <
                &none  &kp EXCL                           &kp AT                        &kp POUND                        &kp DLLR                         &kp PRCNT                 &kp CARET  &kp AMPS   &kp ASTERISK   &kp SEMI   &kp COLON        &none
                &none  &mt LEFT_SHIFT LS(LA(LC(LG(F4))))  &mt LCTRL LS(LA(LC(LG(F3))))  &mt LEFT_ALT LS(LA(LC(LG(F2))))  &mt LEFT_GUI LS(LA(LC(LG(F1))))  &kp LS(LA(LC(LG(F5))))    &kp MINUS  &kp EQUAL  &kp BACKSLASH  &kp GRAVE  &kp NON_US_HASH  &none
                &none  &kp LS(LA(LC(LG(F10))))            &kp LS(LA(LC(LG(F9))))        &kp LS(LA(LC(LG(F8))))           &kp LS(LA(LC(LG(F7))))           &kp LS(LA(LC(LG(F6))))    &kp UNDER  &kp PLUS   &kp PIPE       &kp TILDE  &trans           &none
                                                                                                                          &trans                           &trans                           &trans                    &trans     &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "ADJ";

            bindings = <
                &none  &trans  &trans  &trans  &trans  &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F12  &none
                &none  &trans  &trans  &trans  &trans  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11  &none
                &none  &trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F10  &none
                                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        tvp1_layer {
            display-name = "TVP1";

            bindings = <
                &none  &trans  &trans  &bt BT_CLR_ALL  &trans  &bt BT_SEL 0    &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none
                &none  &trans  &trans  &trans          &trans  &bt BT_SEL 1    &trans  &trans  &trans  &trans             &trans           &none
                &none  &trans  &trans  &trans          &trans  &bt BT_SEL 2    &trans  &trans  &trans  &trans             &trans           &none
                                                   &trans          &trans  &trans          &trans  &trans  &trans
            >;
        };

        tvp2_layer {
            display-name = "TVP2";
            status = "reserved";
        };
    };
};
